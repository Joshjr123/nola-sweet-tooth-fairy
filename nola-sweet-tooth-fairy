        ['Caramel',1.04],['Chocolate',1.04],['White Chocolate',1.04],['Strawberry',1.04],
        ['Butter Syrup',0.52],['Condensed Milk',1.04],['__CUSTOM__']
      ]},

      { cat: 'Drinks', items: [
        ['Coke',2.08],['Sprite',2.08],['Orange Juice',3.13],['Cranberry Juice',3.13],['Apple Juice',3.13],
        ['Water',1.04],['Coffee',2.08],['__CUSTOM__']
