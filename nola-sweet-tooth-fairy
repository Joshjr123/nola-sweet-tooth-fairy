  <!-- SAFE SCRIPT -->
  <script>
    (function () {
      var params = new URLSearchParams(location.search);
      var fromMenu = params.get('from') === 'menu';
      var cat = params.get('cat') || '';

      var title = document.getElementById('customTitle');
      var intro = document.getElementById('customIntro');
      var menuItem = document.getElementById('menuItem');

      if (fromMenu) {
        var label = 'Custom ' + cat;

        if (title) title.textContent = label + ' Order';
        if (intro) {
          intro.textContent =
            'You picked a custom ' + cat + ' item. Tell us how you want it and we’ll build your quote.';
        }

        if (menuItem) menuItem.value = label;

        var typeField = document.getElementById('eventTypeField');
        var dateField = document.getElementById('eventDateField');

        if (typeField) typeField.remove();
        if (dateField) dateField.remove();

        var pricing = document.getElementById('eventPricing');
        if (pricing) pricing.classList.add('hidden');
      }

      document.getElementById('quoteForm').addEventListener('submit', function () {
        var name, price, meta;
